DJANGO_SECRET_KEY=replace-with-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite is used during the scaffold stage.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Reserved for a later PostgreSQL setup. Leave blank for SQLite.
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
