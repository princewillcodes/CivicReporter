DJANGO_SECRET_KEY=local-only-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Replace these placeholders with the connection details from your local PostgreSQL app.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/civicreporter_dev

